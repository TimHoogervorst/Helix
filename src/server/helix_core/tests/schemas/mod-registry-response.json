{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helix.example.com/schemas/mod-registry-response.json",
  "title": "Mod Registry Response",
"description": "Response shape for GET /api/mod-registry/. Includes top-level columnTypes, iconLibrary, and colorPalette keys plus per-workspace entries keyed by mod/workspace ID. Each workspace entry carries workspaceId, schemaTypes (array of {id, displayName, prefix, columns, tags, icon, color}), and actions (array of {id, label, action_type}).",
  "type": "object",
  "properties": {
    "columnTypes": {
      "type": "array",
      "description": "Registered column type definitions with their operators.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase column type identifier, e.g. 'text', 'number'."
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable label, e.g. 'Text', 'Number'."
          },
          "icon": {
            "type": "string",
            "description": "Lucide icon token for this column type."
          },
          "color": {
            "type": "string",
            "description": "Color token key for this column type, e.g. 'flask', 'solvent'."
          },
          "operandShape": {
            "type": "string",
            "description": "Primary operand shape for cell editing and rendering. Valid values: text, number, date, boolean, dropdown, entity-picker, range, none, project-picker."
          },
          "defaultValue": {
            "description": "Default value for cells of this column type. Type varies by operand shape."
          },
          "operators": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "operandShape": { "type": "string" },
                "djangoLookupName": { "type": "string" }
              },
              "required": ["id", "label", "operandShape", "djangoLookupName"]
            }
          },
          "aggregates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "djangoAggregateName": { "type": "string" },
                "resultOperandShape": { "type": "string" }
              },
              "required": ["id", "label", "djangoAggregateName", "resultOperandShape"]
            }
          }
        },
        "required": ["id", "displayName", "icon", "color", "operandShape", "defaultValue", "operators", "aggregates"]
      }
    },
    "iconLibrary": {
      "type": "array",
      "description": "All IconLibraryEntry rows for the frontend lookup store.",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "kind": { "type": "string", "enum": ["lucide", "custom"] },
          "token": { "type": "string" },
          "svg": { "type": "string" }
        },
        "required": ["key", "label", "kind", "token", "svg"]
      }
    },
    "colorPalette": {
      "type": "array",
      "description": "All ColorToken rows for the frontend lookup store.",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "hex": { "type": "string" }
        },
        "required": ["key", "label", "hex"]
      }
    }
  },
  "patternProperties": {
    "^[a-z][a-z0-9_-]*$": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "description": "The workspace identifier, e.g. 'lims' or 'eln'."
        },
        "schemaTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable schema-type identifier, e.g. 'lims.entity' or 'eln.notebookentry'."
              },
              "displayName": {
                "type": "string",
                "description": "Human-readable label."
              },
              "prefix": {
                "type": "string",
                "description": "Default display-ID prefix for new entities of this type."
              },
              "columns": {
                "type": "array",
                "description": "Column definitions for this schema type."
              },
              "tags": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Capability tags declared by the owning mod."
              },
              "icon": {
                "type": "string",
                "description": "Icon key from the default schema, e.g. 'notebook' or 'flask-conical'."
              },
              "color": {
                "type": "string",
                "description": "Color key from the default schema, e.g. 'muted' or 'success'."
              }
            },
            "required": ["id", "displayName", "prefix", "columns", "tags", "icon", "color"]
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "action_type": { "type": "string" }
            },
            "required": ["id", "label", "action_type"]
          }
        }
      },
      "required": ["workspaceId", "schemaTypes", "actions"]
    }
  },
  "additionalProperties": false
}
