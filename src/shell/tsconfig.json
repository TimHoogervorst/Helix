{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@helix/mod-api": ["../mod-api/src/index.ts"],
      "@helix/mod-api/portable-blocks": ["../mod-api/src/portableBlocks.tsx"],
      "@helix/mod-api/host": ["../mod-api/src/elnHost.ts"],
      "@helix/mod-api/*": ["../mod-api/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/__tests__/**"]
}
