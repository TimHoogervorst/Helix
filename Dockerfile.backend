FROM python:3.12-slim

WORKDIR /app

# Bundled mods are copied to /bundled and imported through the bundled.*
# namespace, so the filesystem root must be importable in the backend image.
ENV PYTHONPATH="/:/app"

# Install system dependencies for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc && \
    rm -rf /var/lib/apt/lists/*

COPY src/server/requirements.txt src/server/requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dev.txt

# Only Django project configuration is copied into /app. Platform and mod
# packages are copied separately so their repository tiers remain visible.
COPY src/server/ .
# Keep the ELN's repository-relative setuptools layout intact while building
# its external distribution.  The runtime copy below intentionally remains at
# /mods so the package tiers stay visible to the application.
COPY src/mods/eln/ /build/mods/eln/
COPY src/pyproject.toml /app/pyproject.toml
COPY src/helix_core/ /app/helix_core/
COPY src/mods/ /mods/
COPY src/bundled/ /bundled/

# The ELN is consumed exactly like an installed External Mod during dogfood.
RUN pip install --no-cache-dir --no-deps -e /app && \
    pip install --no-cache-dir --no-deps -e /build/mods/eln

RUN chmod +x /app/entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.sh"]
