FROM node:22-alpine

# Mirror the host's src/ directory structure so that relative imports
# from mod files (../../shell/src/…) resolve identically in the container.
WORKDIR /repo/src/shell

COPY src/shell/package.json src/shell/package-lock.json ./
RUN npm install

COPY src/shell/ .
COPY src/mods/ ../mods/

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
