  },
  "peerDependencies": {
    "@helix/mod-api": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json"
  },
  "helix": {
    "importSpecifier": "@example/hello-world-mod"
  }
}
