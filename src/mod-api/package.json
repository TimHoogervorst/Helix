{
  "name": "@helix/mod-api",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["./style.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
