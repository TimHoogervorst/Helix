    },
    "./manifest": "./modManifest.json",
    "./style.css": "./style.css"
  },
  "peerDependencies": {
    "@tiptap/react": "^3.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "files": ["dist", "modManifest.json", "style.css"]
}
